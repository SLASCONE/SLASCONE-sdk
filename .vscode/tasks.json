{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build linux-native",
      "type": "shell",
      "command": "cmake --build build/linux-native",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
